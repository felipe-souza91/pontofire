# Config web do Firebase (projeto firefinances-4b65f).
# Copie para app/.env.local e preencha com os valores do Console do Firebase
# (Configurações do projeto → Seus apps → App da Web → SDK config).
# Esses valores NÃO são segredos, mas ficam fora do git para o dono preencher.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=firefinances-4b65f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=firefinances-4b65f
VITE_FIREBASE_STORAGE_BUCKET=firefinances-4b65f.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA Enterprise (chave de site pública).
VITE_RECAPTCHA_ENTERPRISE_KEY=

# FCM Web Push (VAPID) — necessário no M7 (push). Deixar vazio por enquanto.
VITE_FCM_VAPID_KEY=
